{
  "name": "iso",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @iso/api dev",
    "dev:web": "pnpm --filter @iso/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @iso/web test:e2e",
    "db:migrate": "pnpm --filter @iso/api prisma:migrate",
    "db:seed": "pnpm --filter @iso/api prisma:seed"
  }
}
