# ── API ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://iso:iso_dev_password@localhost:5432/iso?schema=public
REDIS_URL=redis://localhost:6379

# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth (console.cloud.google.com — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Storage: "local" (dev, writes to .uploads-dev/) or "s3"
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# For Cloudflare R2 / MinIO set the S3 endpoint URL (leave blank for AWS S3):
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# App-layer encryption for SEVIS/passport numbers. Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Email (Phase M5 — Resend or SES)
# Resend: sign up free at resend.com, paste the API key below. Without it,
# reminders are logged instead of sent (app still runs).
EMAIL_FROM=Waypoint <onboarding@resend.dev>
RESEND_API_KEY=

# AI advisor (Groq — free tier, OpenAI-compatible API). Get a key at console.groq.com.
# Without it, the advisor and DSO email drafter respond with a "not configured" message.
GROQ_API_KEY=

# ── Web ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostHog analytics (optional — leave blank to disable). Get a key at posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
